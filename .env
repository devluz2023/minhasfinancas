# ==========================================
# CHAVES DE API (Substitua pelos seus valores reais)
# ==========================================
# Chave da OpenAI (Obrigatória para o código atual)
# Crie em: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Chave da Tavily (Opcional por enquanto, útil para busca na web depois)
# Crie em: https://app.tavily.com/home
TAVILY_API_KEY="tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# CONFIGURAÇÕES DO MODELO
# ==========================================
# Qual modelo da OpenAI você deseja usar (gpt-4o-mini é mais rápido e barato)
MODEL_NAME="gpt-4o-mini"

# Criatividade do modelo (0.0 a 1.0). 0.0 é mais focado/determinístico.
TEMPERATURE=0.0

# ==========================================
# OUTRAS CONFIGURAÇÕES (LangSmith para Debug - Opcional)
# ==========================================
# Se quiser rastrear seus prompts e erros graficamente no LangSmith (https://smith.langchain.com/)
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx"
# LANGCHAIN_PROJECT="meu_projeto_langgraph"